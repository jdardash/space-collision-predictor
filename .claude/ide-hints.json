{
  "$schema": "https://claude.ai/schemas/ide-hints.json",
  "version": "2.0",
  "file_annotations": {
    "src/sda/propagator.py": {
      "badge": "ENGINE",
      "color": "orange",
      "warning": "Core SGP4 engine - changes require full test suite"
    },
    "src/sda/conjunction.py": {
      "badge": "PIPELINE",
      "color": "red",
      "warning": "Safety-critical risk classification - update tests when changing thresholds"
    },
    "src/sda/models.py": {
      "badge": "MODELS",
      "color": "blue",
      "note": "Shared Pydantic models - changes cascade to all modules"
    },
    "src/sda/visualization.py": {
      "badge": "VIZ",
      "color": "green",
      "note": "Plotly 3D rendering - ECI frame only"
    },
    "src/sda/api.py": {
      "badge": "API",
      "color": "purple",
      "note": "FastAPI service - seeds from CelesTrak on startup"
    },
    "src/sda/tle_store.py": {
      "badge": "STORE",
      "color": "teal",
      "note": "In-memory TLE catalog - no persistence"
    },
    "tests/**/*.py": {
      "badge": "TEST",
      "color": "yellow",
      "note": "Test files"
    },
    ".claude/**/*": {
      "badge": "CLAUDE",
      "color": "cyan",
      "note": "AI assistant configuration"
    }
  },
  "quick_actions": {
    "src/sda/**/*.py": [
      {
        "label": "Run Tests",
        "command": "pytest tests/ -x --tb=short"
      },
      {
        "label": "Run With Coverage",
        "command": "pytest tests/ --cov=src/sda --cov-report=term-missing"
      }
    ],
    "tests/**/*.py": [
      {
        "label": "Run This Test",
        "command": "pytest ${file} -v"
      },
      {
        "label": "Debug Test",
        "command": "pytest ${file} -v --pdb"
      }
    ],
    "src/sda/api.py": [
      {
        "label": "Start Server",
        "command": "python -m sda.api"
      }
    ]
  },
  "keyboard_shortcuts": {
    "Ctrl+Shift+T": {
      "command": "pytest tests/ -x --tb=short",
      "description": "Run test suite"
    },
    "F5": {
      "command": "python -m sda.api",
      "description": "Start API server"
    }
  },
  "diagnostics": {
    "real_time_checks": [
      {
        "pattern": "WGS84",
        "severity": "warning",
        "message": "Using WGS84 - this project uses WGS72 for SGP4 compatibility"
      },
      {
        "pattern": "from sgp4.earth_gravity import",
        "severity": "warning",
        "message": "Legacy sgp4 import - use sgp4.api instead"
      },
      {
        "pattern": "satrec\\.sgp4\\([^,]+\\)",
        "severity": "error",
        "message": "sgp4() requires two args (jd, fr) - use datetime_to_jd() helper"
      },
      {
        "pattern": "ECEF|ecef|geodetic",
        "severity": "warning",
        "message": "Non-ECI coordinate detected - this project uses ECI frame only"
      }
    ]
  },
  "workspace_recommendations": {
    "extensions": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "tamasfe.even-better-toml"
    ],
    "settings": {
      "python.analysis.typeCheckingMode": "basic",
      "python.testing.pytestEnabled": true,
      "python.testing.pytestArgs": ["tests/"],
      "editor.formatOnSave": true,
      "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        ".pytest_cache": true,
        "*.egg-info": true
      }
    }
  }
}
